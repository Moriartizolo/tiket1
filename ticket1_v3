from dataclasses import dataclass
from typing import Dict, List, Protocol


@dataclass(frozen=True)
class MatchEvent:
    type: str
    payload: str


class Observer(Protocol):
    def update(self, event: MatchEvent) -> None:
        ...


class MatchEventPublisher:
    def __init__(self) -> None:
        self._observers: List[Observer] = []

    def subscribe(self, observer: Observer) -> None:
        if observer not in self._observers:
            self._observers.append(observer)

    def unsubscribe(self, observer: Observer) -> None:
        if observer in self._observers:
            self._observers.remove(observer)

    def notify(self, event: MatchEvent) -> None:
        for obs in list(self._observers):
            obs.update(event)


class LoggerObserver:
    def update(self, event: MatchEvent) -> None:
        print("[LOG] type={0} payload={1}".format(event.type, event.payload))


class StatsObserver:
    def __init__(self) -> None:
        self._counts: Dict[str, int] = {}

    def update(self, event: MatchEvent) -> None:
        self._counts[event.type] = self._counts.get(event.type, 0) + 1

    def snapshot(self) -> Dict[str, int]:
        return dict(self._counts)


class AchievementObserver:
    def __init__(self) -> None:
        self._unlocked = False

    def update(self, event: MatchEvent) -> None:
        # FIX: normalize event type
        if event.type.upper() == "WIN" and not self._unlocked:
            self._unlocked = True
            print("[ACHIEVEMENT] Winner Winner Chicken Dinner!")

    def is_unlocked(self) -> bool:
        return self._unlocked


def main() -> int:
    publisher = MatchEventPublisher()

    logger = LoggerObserver()
    stats = StatsObserver()
    achievement = AchievementObserver()

    publisher.subscribe(logger)
    publisher.subscribe(stats)
    publisher.subscribe(achievement)

    events = [
        MatchEvent(type="KILL", payload="PlayerA killed PlayerB"),
        MatchEvent(type="ZONE", payload="Zone is shrinking"),
        MatchEvent(type="KNOCK", payload="PlayerC knocked PlayerD"),
        MatchEvent(type="win", payload="PlayerA won the match"),
    ]

    for e in events:
        publisher.notify(e)

    print("[STATS]", stats.snapshot())
    print("[ACHIEVEMENT_UNLOCKED]", achievement.is_unlocked())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
